# SalesFlow-Lite environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored by default.

# --- Google Cloud / Sheets / Places ---
# Path to the service account JSON key file (see docs/GOOGLE_CLOUD_SETUP.md)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# Target spreadsheet ID (from the Sheets URL, see docs/GOOGLE_CLOUD_SETUP.md Step 6.7)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google Cloud project ID (for reference/logging, not strictly required at runtime)
GOOGLE_CLOUD_PROJECT_ID=

# --- AgentMail (sole supported email provider, drafts-only, see docs/SPEC.md §6.3) ---
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# --- Notification delivery (multi-channel; see docs/SPEC.md §7.1, docs/RECIPE.md §1.7) ---
# Notifications now support multiple simultaneous destinations across
# different channels (telegram, discord, slack, email, sms, webhook, none).
# The canonical routing config (named destinations + per-event-type routes)
# lives in the Config tab / AppConfig, not here — these two vars remain as
# a minimal single-destination fallback for the simplest possible install
# (one operator, one channel) and for the doctor script's basic env check.
# One of: telegram | discord | slack | email | sms | webhook | none
NOTIFICATION_CHANNEL=none
NOTIFICATION_TARGET=

# --- Digest notification (optional; see docs/SPEC.md §7.2) ---
# Full digest configuration (cron schedule, sections, destinations) lives in
# the Config tab / AppConfig.digest — set DIGEST_ENABLED=true here only to
# confirm at a glance whether this install has a digest turned on.
DIGEST_ENABLED=false

# --- Operating environment ---
# development | production
NODE_ENV=development

# Optional: override log verbosity (debug | info | warn | error)
LOG_LEVEL=info
