{
  "name": "salesflow-lite",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw-native batch lead packs and lightweight CRM tooling for small businesses.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\" \"*.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx bin/doctor.ts",
    "doctor:fix": "tsx bin/doctor.ts --fix",
    "lead:doctor": "tsx bin/salesflow-lite.ts doctor",
    "lead:discover": "tsx bin/salesflow-lite.ts discover",
    "lead:research": "tsx bin/salesflow-lite.ts research",
    "lead:pipeline": "tsx bin/salesflow-lite.ts pipeline",
    "lead:batch": "tsx bin/salesflow-lite.ts run-batch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^178.0.0",
    "zod": "^3.23.0"
  }
}
