{
  "name": "salesflow-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight, Sheets-backed lead generation and sales pipeline CRM for small businesses, built on OpenClaw.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx bin/doctor.ts",
    "doctor:fix": "tsx bin/doctor.ts --fix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  }
}
